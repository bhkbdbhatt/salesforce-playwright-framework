# Salesforce org instance URL (My Domain), not login.salesforce.com
SF_BASE_URL=https://your-domain.my.salesforce.com
SF_USERNAME=your_username@example.com
SF_PASSWORD=your_password

# Optional: Salesforce REST API version override (defaults to v60.0)
SF_API_VERSION=v60.0

# Optional: timeout for each Salesforce REST/SOAP request in milliseconds
SF_API_TIMEOUT_MS=60000

# Optional: overrides EXECUTION_MODE from config/execution.config.ts.
# 'api' runs create/update/convert/delete through REST/SOAP; 'ui' runs them
# through Salesforce Lightning. Read-only SOQL/REST verification always uses the API.
SF_EXECUTION_MODE=api

# Optional: set to true to force a fresh interactive login even when the saved
# session in .auth/user.json is still valid
SF_FORCE_LOGIN=false

# Optional auth timeouts (milliseconds)
SF_LOGIN_TIMEOUT_MS=30000
SF_MFA_TIMEOUT_MS=300000

# Optional: set to true to pause in Playwright Inspector for MFA instead of
# waiting for the browser login to finish on its own
SF_MFA_PAUSE=false

# Optional: TestDino reporter token. The reporter is only registered when set.
TESTDINO_TOKEN=
