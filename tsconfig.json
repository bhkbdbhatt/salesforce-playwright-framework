{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "tests/**/*",
        "utils/**/*",
        "page-objects/**/*",
        "api/**/*",
        "config/**/*",
        "services/**/*",
        "ui/**/*"
    ]
}